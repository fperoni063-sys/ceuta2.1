# CEUTA Web Project Configuration
# Copy to .env.local before starting

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service Role Key (only for admin API routes)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# WhatsApp (for floating button)
NEXT_PUBLIC_WHATSAPP_BOT=+59898910715
NEXT_PUBLIC_WHATSAPP_JULIA=+59898843651

# Site URL (change in production, no trailing slash — used in magic links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email — Resend (recommended on Vercel). Free: 100/day, 3000/month.
RESEND_API_KEY=
EMAIL_FROM=CEUTA <onboarding@resend.dev>

# Email — SMTP fallback (optional). Use an App Password, not the Gmail login password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Vercel Cron auth (required in production; Vercel sends it as Bearer)
CRON_SECRET=
